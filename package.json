{
  "name": "csa-volleyball-site",
  "private": true,
  "type": "module",
  "description": "CSA Volleyball public site. website/ is what Vercel serves; data/ and handbooks/src are the sources.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pdf": "python3 scripts/build_pdfs.py",
    "check": "node scripts/check.mjs",
