  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "html-validate": "9.4.1",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.56.0"
  }
}
